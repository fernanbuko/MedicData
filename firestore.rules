rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{ownerUid} {

      // La entrada de un/a colaborador/a se crea por la propia persona en
      // el momento de unirse con el código de invitación (todavía no
      // aparece en la lista de colaboradores del consultorio, así que la
      // regla general de más abajo no le daría permiso). Una vez creada,
      // solo el/la dueño/a del consultorio puede editarla o borrarla; el
      // propio colaborador solo puede leer su fila (para saber qué
      // secciones tiene habilitadas).
      match /colaboradores/{colabId} {
        allow read: if request.auth != null && (
          request.auth.uid == ownerUid ||
          request.auth.uid == colabId ||
          request.auth.token.email == "fernandotapia7@gmail.com"
        );
        allow create: if request.auth != null && request.auth.uid == colabId;
        allow update, delete: if request.auth != null && request.auth.uid == ownerUid;
      }

      // Todo lo demás bajo users/{ownerUid}/... (config, pacientes,
      // consultas, recetas, exámenes, citas, meta…): el/la dueño/a de la
      // cuenta, o cualquier colaborador/a ya aceptado en su equipo.
      match /{document=**} {
        allow read, write: if request.auth != null && (
          request.auth.uid == ownerUid ||
          exists(/databases/$(database)/documents/users/$(ownerUid)/colaboradores/$(request.auth.uid))
        );
      }
    }

    // Panel de administración (ver PanelAdminView en el código): un
    // resumen liviano de cada consultorio (nombre, correo, fechas), NO
    // sus datos clínicos — esos siguen protegidos por las reglas de
    // arriba. Solo quien inicia sesión con el correo fijado en
    // ADMIN_EMAIL (dentro de index.html) puede ver la lista completa y
    // bloquear/desbloquear una cuenta; cambia ese valor por el tuyo si vas
    // a usar esta parte, y también aquí abajo, en las dos líneas que
    // dicen "fernandotapia7@gmail.com" — deben ser el mismo correo.
    match /cuentasRegistradas/{uid} {
      allow get: if request.auth != null && (
        request.auth.uid == uid ||
        request.auth.token.email == "fernandotapia7@gmail.com" ||
        exists(/databases/$(database)/documents/users/$(uid)/colaboradores/$(request.auth.uid))
      );
      allow list: if request.auth != null && request.auth.token.email == "fernandotapia7@gmail.com";
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.bloqueada == false;
      allow update: if request.auth != null && (
        request.auth.token.email == "fernandotapia7@gmail.com" ||
        (
          (request.auth.uid == uid ||
           exists(/databases/$(database)/documents/users/$(uid)/colaboradores/$(request.auth.uid))) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["ultimaConexion", "logoUrl", "fotoMedico", "nombreConsultorio", "nombreMedico"])
        )
      );
      allow delete: if false;
    }

    // Los códigos de invitación: se necesitan ANTES de iniciar sesión (para
    // validar el código al unirse a un equipo), así que su lectura es
    // pública — el código en sí es una cadena al azar difícil de adivinar,
    // y conocer a quién pertenece no da acceso a ningún dato. Solo el
    // propio dueño puede crear el suyo, y no se puede modificar ni borrar
    // desde el cliente.
    match /inviteCodes/{codigo} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
